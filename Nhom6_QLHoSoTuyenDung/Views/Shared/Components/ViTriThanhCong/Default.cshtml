@model List<Nhom6_QLHoSoTuyenDung.Models.ViewModels.ThongKe.ViTriThanhCongVM>

@{
    int stt = 1;
}
<div class="table-responsive">
    <table class="table table-hover table-bordered table-sm align-middle mb-0">
        <thead class="table-light" style="font-size: .8rem; color: #475569;">
            <tr>
                <th class="text-center" style="width: 45px;">#</th>
                <th>Vị trí tuyển dụng</th>
                <th>Phòng ban</th>
                <th class="text-center" style="width: 130px;">Số lượng tuyển</th>
                <th class="text-center" style="width: 140px;">Ngày tuyển gần nhất</th>
            </tr>
        </thead>
        <tbody style="font-size: .8125rem;">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center text-muted fw-semibold">@(stt++)</td>
                        <td class="fw-bold text-dark">@item.TenViTri</td>
                        <td class="text-secondary">@item.PhongBan</td>
                        <td class="text-center">
                            <span class="badge" style="background: #e0f2fe; color: #0369a1; font-size: .82rem; font-weight: 700; padding: .25rem .55rem;">
                                @item.SoLuongTuyen người
                            </span>
                        </td>
                        <td class="text-center text-muted small">@item.NgayTuyenGanNhat</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-4 text-muted fst-italic">Không có dữ liệu vị trí tuyển thành công.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
