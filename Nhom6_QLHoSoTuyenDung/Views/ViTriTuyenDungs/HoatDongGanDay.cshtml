@using Nhom6_QLHoSoTuyenDung.Models.Helpers
@using Nhom6_QLHoSoTuyenDung.Models.ViewModels
@using Nhom6_QLHoSoTuyenDung.Models.ViewModels.Dashboard
@using Nhom6_QLHoSoTuyenDung.Models.ViewModels.ViTriTuyenDungVM
@model List<HoatDongDashboardVM>

@{
    ViewData["Title"] = "Hoạt động gần đây";
}

<div class="container-fluid px-4 mt-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center gap-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" style="border-radius: .5rem; font-size: .85rem; font-weight: 600;">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
            <h4 class="fw-bold m-0 text-dark" style="font-size: 1.25rem;">Tất cả hoạt động trong 7 ngày gần đây</h4>
        </div>
    </div>

    <div class="viti-panel p-3" style="background: #fff; border: 1px solid #e2e8f0; border-radius: .75rem;">
        @if (Model != null && Model.Any())
        {
            @foreach (var log in Model)
            {
                var boxClass = log.Loai switch
                {
                    "create" => "activity-box activity-create",
                    "upload" => "activity-box activity-upload",
                    "schedule" => "activity-box activity-schedule",
                    "complete" => "activity-box activity-complete",
                    _ => "activity-box"
                };

                <div class="@boxClass p-3 mb-2 rounded-3" style="background: #f8fafc; border: 1px solid #f1f5f9;">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-semibold text-dark" style="font-size: .9rem;">@log.TieuDe</div>
                            <div class="text-muted mb-1 small">@log.NoiDung</div>
                            @if (!string.IsNullOrEmpty(log.Icon) || !string.IsNullOrEmpty(log.NguoiThucHien))
                            {
                                <div class="d-flex align-items-center gap-2 small text-muted">
                                    @if (!string.IsNullOrEmpty(log.Icon))
                                    {
                                        <i class="@log.Icon text-primary"></i>
                                    }
                                    <span class="fw-medium">@log.NguoiThucHien</span>
                                </div>
                            }
                        </div>
                        @if (log.ThoiGian.HasValue)
                        {
                            <div class="text-end text-muted small">
                                <i class="bi bi-clock me-1"></i>@ThoiGianHelper.TinhTuLuc(log.ThoiGian.Value)
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-4 text-muted fst-italic">Chưa có hoạt động nào recorded trong 7 ngày gần đây.</div>
        }
    </div>
</div>

